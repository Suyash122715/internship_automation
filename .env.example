# Internship Agent Configuration (PRD Compliant)
# Copy this file to .env and adjust values for local development.
# Do NOT commit real passwords or credentials to version control.

APP_NAME="Internship Automation Agent"
APP_ENV="development"
DEBUG=true

# Server
HOST="127.0.0.1"
PORT=8000

# SQLite Database
DATABASE_URL="sqlite:///./internship_agent.db"

# Email / SMTP Configuration (PRD Section 15 & 19)
# By default, EMAIL_SIMULATE is true (safe sandbox mode)
EMAIL_SIMULATE=true
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=true
EMAIL_FROM=""
EMAIL_FROM_NAME="Internship Applicant"

# Safe Rate Limiting
EMAIL_RATE_LIMIT_PER_MINUTE=5
EMAIL_RATE_LIMIT_PER_DAY=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
